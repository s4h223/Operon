# Required: your Anthropic API key. Never expose this to the client -
# it's only read server-side inside app/api/solve/route.ts.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model used for /api/solve (defaults to claude-opus-5).
# ANTHROPIC_SOLVE_MODEL=claude-opus-5

# Optional: a Desmos API key for the embedded calculator preview.
# The app falls back to Desmos's public "demo" key if unset, which is fine
# for local development but should be replaced with a registered key
# (https://www.desmos.com/api/v1.11/docs/index.html) before shipping to users.
# NEXT_PUBLIC_DESMOS_API_KEY=your-desmos-key
